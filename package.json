  "scripts": {
    "extract-skill": "bun scripts/extract-skill.ts",
    "export-commands": "bun scripts/export-commands.ts",
    "sync-dispatch": "bun scripts/sync-dispatch.ts",
    "sync": "python3 scripts/sync_registry.py && bun scripts/sync-dispatch.ts",
    "setup": "bun scripts/export-commands.ts --setup",
    "test": "bun test",
    "test:parallel": "bun test --parallel --timeout 30000",
    "secret-scan": "bun scripts/secret-scan.ts",
    "validate": "bash skills/core-engine/updateagents/scripts/validate-memory-file.sh",
    "lint": "biome check . && bash scripts/ruff-check.sh",
    "type-check": "tsc --noEmit",
    "check:landed": "bun scripts/check-landed.ts",
    "check:sync": "bun scripts/check-sync.ts",
    "check:docs-commands": "bun scripts/audit-doc-commands.ts",
    "check:mcp": "bun scripts/check-mcp.ts",
    "check:surface": "bun scripts/sync-skill-surface.ts --check",
    "sync:surface": "bun scripts/sync-skill-surface.ts --write",
    "check:hygiene": "bun skills/core-engine/updateagents/scripts/updateagents.ts . --hygiene --check-public",
    "hygiene": "bun skills/core-engine/updateagents/scripts/updateagents.ts . --hygiene",
    "release:smoke": "bun scripts/release-smoke.ts",
    "check:deps": "bun scripts/check-deps.ts",
    "check:ledger": "bun scripts/check-docs-ledger.ts",
    "check:harness": "bun scripts/sync-harness-docs.ts --check",
    "sync:harness": "bun scripts/sync-harness-docs.ts --write",
    "check:routing:signals": "bun scripts/sync-routing-signals.ts --check",
    "sync:routing:signals": "bun scripts/sync-routing-signals.ts --write",
    "check:routing": "bun scripts/eval-routing.ts",
    "check:routing:heldout": "bun scripts/eval-routing.ts --fixtures tests/fixtures/routing-eval/heldout-v5.json --min-exact 0 --min-skill 0",
    "check:routing:engineering": "bun scripts/eval-routing.ts --fixtures tests/fixtures/routing-eval/heldout-v6.json --min-exact 0 --min-skill 0",
    "check:routing:v7": "bun scripts/eval-routing.ts --fixtures tests/fixtures/routing-eval/heldout-v7.json --min-exact 0 --min-skill 0",
    "check:routing:v8": "bun scripts/eval-routing.ts --fixtures tests/fixtures/routing-eval/heldout-v8.json --min-exact 0 --min-skill 0",
    "check:routing:matrix": "bun scripts/check-routing-matrix.ts",
    "check:routing:docs": "bun scripts/sync-routing-docs.ts --check",
    "sync:routing:docs": "bun scripts/sync-routing-docs.ts --write",
    "sync:routing:baseline": "bun scripts/check-routing-matrix.ts --update",
    "check:install": "bun scripts/check-install-matrix.ts",
    "muse": "bun scripts/muse.ts"
  },
  "type": "module",
  "version": "8.4.2",
