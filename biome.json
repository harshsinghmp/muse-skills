{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!.venv-report",
      "!node_modules",
      "!**/*.map",
      "!.agents",
      "!.opencode",
      "!.codex",
      "!.cursor",
      "!.gemini",
      "!.continue",
      "!.crush",
      "!.aider",
      "!.cline",
      "!.trae",
      "!.memory",
      "!docs/**/*.html",
      "!**/*.css",
      "!**/*.yaml",
      "!**/*.yml",
      "!skills/context-orchestration/secretary/references/routing-signals.json",
      "!skills/context-orchestration/secretary/scripts/routing-defaults.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": ["**", "!**/*.md", "!**/*.mdc", "!**/*.yaml", "!**/*.yml"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
